{
  "manifest_version": 3,
  "name": "XDM New Browser Monitor",
  "version": "0.1.0",
  "description": "Sends direct browser downloads to the local XDM New app when monitoring is enabled.",
  "permissions": ["downloads", "storage", "nativeMessaging"],
  "key": "",
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Enable XDM New download monitoring" }
}
